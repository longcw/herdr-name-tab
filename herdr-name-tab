#!/usr/bin/env python3
"""Name the Herdr tab this process runs in, from what was typed into it."""

import json
import os
import re
import subprocess
import sys
import time
import shlex
import urllib.request

MAX_LEN = 16
# a name comes out of the opening words; the rest is only tokens
MAX_INPUT = 240
STATE_DIR = os.path.expanduser("~/.local/state/herdr-tab-names")
LOG_PATH = os.path.join(STATE_DIR, "calls.jsonl")
# the log is append-only, so it is halved rather than allowed to grow forever
LOG_MAX_BYTES = 2 << 20
# rename a tab to this to clear its name and have it named again
RESET_LABEL = "-"
# clearing the screen is how a shell tab says the work changed
RESET_COMMANDS = {"clear", "reset"}
CONFIG_PATH = os.path.expanduser("~/.config/herdr-name-tab/config.json")

# commands that say nothing about what a tab is for: moving around, looking
# around, and running the shell itself. Replaceable through "ignore".
IGNORED = {
    "cd", "z", "pushd", "popd", "ls", "ll", "la", "lsd", "eza", "exa", "tree", "pwd",
    "clear", "reset", "exit", "logout",
    "echo", "which", "type", "whoami", "date", "uptime", "man", "history",
    "env", "printenv", "export", "source", "alias", "unalias",
    "cat", "bat", "less", "more",
}
# an agent names its tab from its prompts, not from the command that launched it
AGENTS = {"claude", "codex", "copilot", "droid", "opencode", "cursor", "qwen", "grok", "kimi"}
# what a pane is running when it is running nothing in particular
SHELLS = {"bash", "zsh", "fish", "sh", "dash", "ksh", "tcsh", "csh", "nu", "xonsh", "elvish"}
# commands that put you somewhere else: they make the tab's current name wrong,
# they name it for as long as they run, and nothing fires again until they exit
TAKEOVER = {"ssh", "mosh", "et", "telnet", "tsh", "sshpass", "vagrant", "distrobox"}

PROMPT = """You name terminal tabs. Reply with the tab name only, nothing else.

A name is:
- one word; two only when one cannot identify the work; never three
- all lowercase, a hyphen between two words, no spaces or punctuation
- at most 16 characters
- just the number when the work ITSELF is an issue, PR or ticket. A number mentioned in passing is not the name
- the distinctive term, never a general one. agent, cloud, code, session, protocol, task, server, api, fix, test, update, plugin are general - reach past them for what makes THIS work different

ANCHOR is the first thing typed in this tab. It defines what the tab is for.
LATEST is the most recent thing typed. It is almost always the same work continuing - a follow-up, a correction, a question, a new angle on the same job.
NAME is what the tab is called now.

Your answer is NAME, copied exactly, unless LATEST turns the tab to work unrelated to ANCHOR.
Changing tools, changing your mind, correcting course or digging into a detail is the same work, and the same name.
A better name for the same work is not a reason to change it. Only an unrelated subject is.
ANCHOR can be garbled - it is often dictated, so it may have misheard a word. When LATEST shows ANCHOR named the wrong thing, correct NAME to the work LATEST reveals.
When NAME is (none), name the work in ANCHOR."""

try:
    with open(CONFIG_PATH) as handle:
        CONFIG = json.load(handle)
except Exception:
    CONFIG = {}


def setting(key, default=None):
    """A setting from the environment, then the config file, then the default."""
    return os.environ.get("HERDR_NAME_TAB_" + key.upper()) or CONFIG.get(key) or default


def ask_model(query):
    """Ask the configured model to name the tab. Returns the answer and its cost."""
    url = setting("api_url")

    if not url:
        # no endpoint configured: the CLI works but boots a whole process per
        # call, which costs about four seconds against under one over HTTP
        try:
            return subprocess.run(
                ["claude", "-p", "--model", setting("model", "haiku")],
                input=query, capture_output=True, text=True, timeout=60,
            ).stdout, {}
        except Exception:
            return "", {}

    if not url.rstrip("/").endswith("/chat/completions"):
        url = url.rstrip("/") + "/chat/completions"

    key = setting("api_key") or os.environ.get(setting("api_key_env", "OPENAI_API_KEY"), "")
    headers = {"content-type": "application/json"}
    if key:
        headers["authorization"] = "Bearer " + key

    body = json.dumps({
        "model": setting("model", "gpt-4o-mini"),
        "messages": [{"role": "user", "content": query}],
        "max_tokens": 16,
        "temperature": 0,
    }).encode()

    try:
        request = urllib.request.Request(url, data=body, headers=headers, method="POST")
        with urllib.request.urlopen(request, timeout=15) as response:
            answer = json.load(response)
        return answer["choices"][0]["message"]["content"], answer.get("usage") or {}
    except Exception:
        return "", {}


# ssh options that take a value, so the token after them is never the host
SSH_VALUE_FLAGS = set("bcDEeFIiJLlmOopQRSWw")


def ssh_host(command):
    """The host an ssh-style command connects to, or "" when it names none."""
    try:
        tokens = shlex.split(command)
    except ValueError:
        tokens = command.split()

    host, index = "", 1
    while index < len(tokens):
        token = tokens[index]
        if token.startswith("-"):
            # -p 2222 hides the host one token further along; -p2222 does not
            index += 2 if len(token) == 2 and token[1] in SSH_VALUE_FLAGS else 1
            continue
        # sshpass ssh host, and ssh -- host, both put a word before the host
        if token in ("ssh", "mosh", "--"):
            index += 1
            continue
        host = token
        break

    if not host:
        return ""

    host = re.sub(r"^[a-z]+://", "", host).split("/")[0]
    host = host.rsplit("@", 1)[-1]

    bracketed = re.match(r"^\[(.+)\]", host)
    if bracketed:
        return bracketed.group(1)

    # a lone colon is a port; several mean this is a bare IPv6 address
    return host.rsplit(":", 1)[0] if host.count(":") == 1 else host


def ssh_label(command):
    """A tab name for an ssh-style command: the host, never the user."""
    host = ssh_host(command)
    if not host:
        return ""

    # an address has no memorable part, so the last group stands in for it
    if re.fullmatch(r"[0-9.]+", host):
        return "ssh-" + host.rsplit(".", 1)[-1]
    if ":" in host:
        return "ssh-" + host.rsplit(":", 1)[-1]

    return host.split(".")[0]


def idle_label():
    """What a tab is called when it holds no work: its agent, else its shell."""
    choice = str(setting("clear_label", "auto"))
    if choice != "auto":
        return choice

    pane = os.environ.get("HERDR_PANE_ID")
    try:
        panes = json.loads(subprocess.run(
            ["herdr", "api", "snapshot"], capture_output=True, text=True, timeout=5
        ).stdout)["result"]["snapshot"]["panes"]
        found = next((p for p in panes if p["pane_id"] == pane), {})
    except Exception:
        found = {}

    agent = found.get("display_agent") or found.get("agent")
    if agent:
        return str(agent)

    # the shell the pane is actually running, which $SHELL only guesses at:
    # it names the login shell, not the one in front of you
    try:
        info = json.loads(subprocess.run(
            ["herdr", "pane", "process-info", "--pane", pane],
            capture_output=True, text=True, timeout=5,
        ).stdout)["result"]["process_info"]["foreground_processes"]
        shell = next((p["name"] for p in info if p.get("name") in SHELLS), "")
    except Exception:
        shell = ""

    return shell or os.path.basename(os.environ.get("SHELL", "")) or RESET_LABEL


def head_of(command):
    """The program a command line runs, without its path."""
    return re.split(r"[\s;|&]+", command.strip())[0].rsplit("/", 1)[-1]


def record(entry):
    """Append one line about a naming to the log, trimming it when it grows."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        if os.path.exists(LOG_PATH) and os.path.getsize(LOG_PATH) > LOG_MAX_BYTES:
            with open(LOG_PATH) as handle:
                lines = handle.readlines()
            with open(LOG_PATH, "w") as handle:
                handle.writelines(lines[len(lines) // 2:])

        entry["at"] = time.time()
        with open(LOG_PATH, "a") as handle:
            handle.write(json.dumps(entry) + "\n")
    except Exception:
        pass


def latest_input():
    """The text to name from: a hook's JSON prompt on stdin, or the argv command."""
    if len(sys.argv) > 1:
        command = " ".join(sys.argv[1:]).strip()
        if head_of(command) in set(setting("ignore", IGNORED)) or head_of(command) in AGENTS:
            return ""
        return command

    if sys.stdin.isatty():
        return ""

    try:
        return str(json.load(sys.stdin).get("prompt") or "").strip()
    except Exception:
        return ""


def slug(raw):
    """Reduce a model answer to a tab label, or "" when it produced none."""
    name = raw.strip().splitlines()[0] if raw.strip() else ""

    # a model that answered in a sentence did not answer with a name
    if len(name.split()) > 3:
        return ""

    name = re.sub(r"[^a-z0-9-]+", "-", name.lower()).strip("-")
    name = re.sub(r"-{2,}", "-", name)

    # two words at most, whatever the model answered
    name = "-".join(name.split("-")[:2])

    if len(name) > MAX_LEN:
        # cut on a hyphen so the label ends on a whole word
        name = name[:MAX_LEN].rsplit("-", 1)[0] if "-" in name[:MAX_LEN] else name[:MAX_LEN]

    return name.strip("-")


def reset(path, tab):
    """Forget the tab's topic and label so the next input names it afresh."""
    # a shell hook leaves stdin on the terminal, where there is nothing to read
    try:
        source = "" if sys.stdin.isatty() else str(json.load(sys.stdin).get("source") or "")
    except Exception:
        source = ""

    # a compacted or resumed session is the same work; a cleared one is not
    if source not in ("clear", "startup", ""):
        return

    try:
        with open(path) as handle:
            state = json.load(handle)
    except Exception:
        state = {}

    # a name the user chose stays theirs across a clear
    if state.get("released"):
        return

    # the old name now describes work that is over, so the tab is set back to
    # the label that asks to be named. Remembering it is what lets a rename
    # you make between here and the next input still count as yours.
    label = idle_label()
    subprocess.run(["herdr", "tab", "rename", tab, label], capture_output=True, timeout=5)

    # "fresh" is what stops `fish` or `claude` being offered to the model as a
    # name worth keeping, while still catching a rename you make before the
    # next input arrives
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(path, "w") as handle:
        json.dump({"name": label, "fresh": True}, handle)


def stats(days):
    """Print what the namer has called, cost and produced over the last `days`."""
    try:
        with open(LOG_PATH) as handle:
            rows = [json.loads(line) for line in handle if line.strip()]
    except Exception:
        rows = []

    cutoff = time.time() - days * 86400
    rows = [r for r in rows if r.get("at", 0) >= cutoff]
    if not rows:
        print(f"no namings in the last {days} days ({LOG_PATH})")
        return

    def totals(since):
        picked = [r for r in rows if r.get("at", 0) >= time.time() - since * 86400]
        used = sum((r.get("tokens_in") or 0) + (r.get("tokens_out") or 0) for r in picked)
        # an ssh name is parsed, not asked for, so it is a naming but not a call
        asked = sum(1 for r in picked if r.get("kind") != "ssh")
        return len(picked), asked, used, sum(1 for r in picked if r.get("changed"))

    print(f"{'period':<14}{'namings':>9}{'calls':>8}{'tokens':>10}{'renames':>9}")
    for label, since in (("today", 1), ("last 7 days", 7), ("last 30 days", 30)):
        if since <= days:
            n, calls, used, changed = totals(since)
            print(f"{label:<14}{n:>9}{calls:>8}{used:>10,}{changed:>9}")

    by_day = {}
    for r in rows:
        day = time.strftime("%Y-%m-%d", time.localtime(r.get("at", 0)))
        n, used = by_day.get(day, (0, 0))
        by_day[day] = (n + 1, used + (r.get("tokens_in") or 0) + (r.get("tokens_out") or 0))

    print("\nby day")
    widest = max(n for n, _ in by_day.values())
    for day in sorted(by_day)[-14:]:
        n, used = by_day[day]
        print(f"  {day}  {'#' * max(1, round(20 * n / widest)):<20} {n:>4}  {used:>8,} tok")

    print("\nrecent names")
    for r in rows[-20:]:
        when = time.strftime("%m-%d %H:%M", time.localtime(r.get("at", 0)))
        cost = "free" if not r.get("tokens_in") else f"{(r.get('tokens_in') or 0) + (r.get('tokens_out') or 0)} tok"
        arrow = "->" if r.get("changed") else "  "
        text = (r.get("input") or "").replace("\n", " ")[:46]
        print(f"  {when}  {r.get('kind', ''):<7} {text:<48} {arrow} {r.get('name') or '(none)':<14} {cost}")


def main():
    if "--stats" in sys.argv:
        rest = [a for a in sys.argv[sys.argv.index("--stats") + 1:] if a.isdigit()]
        stats(int(rest[0]) if rest else 30)
        return

    tab = os.environ.get("HERDR_TAB_ID")
    if os.environ.get("HERDR_ENV") != "1" or not tab or not os.environ.get("HERDR_SOCKET_PATH"):
        return

    path = os.path.join(STATE_DIR, re.sub(r"[^A-Za-z0-9]", "_", tab) + ".json")

    if "--reset" in sys.argv:
        reset(path, tab)
        return

    if len(sys.argv) > 1 and head_of(" ".join(sys.argv[1:])) in RESET_COMMANDS:
        reset(path, tab)
        return

    text = latest_input()
    if not text:
        return

    try:
        with open(path) as handle:
            state = json.load(handle)
    except Exception:
        state = {}

    try:
        listed = json.loads(subprocess.run(
            ["herdr", "tab", "list"], capture_output=True, text=True, timeout=5
        ).stdout)["result"]["tabs"]
    except Exception:
        return

    label = next((t["label"] for t in listed if t["tab_id"] == tab), None)
    if label is None:
        return

    # the sentinel is how a tab you named yourself is handed back
    if label.strip().lower() == setting("reset_label", RESET_LABEL):
        state = {}

    # a tab renamed by anyone but us is theirs, and stays theirs
    if state.get("released"):
        return

    ours = state.get("name")

    # a tab holding only its shell or agent name is unnamed, whatever the
    # label says — but a label that differs from it is still someone's rename
    fresh = state.get("fresh")

    if ours and label != ours:
        state["released"] = True
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(path, "w") as handle:
            json.dump(state, handle)
        return

    # a shell holds many unrelated commands, so every one of them would read as
    # a change of subject: a tab named from a command keeps that name
    if fresh:
        ours = None

    # a takeover command starts new work and is the last thing this tab will
    # report, so it names the tab whatever the tab was called and whatever the
    # pace says
    if len(sys.argv) > 1 and head_of(" ".join(sys.argv[1:])) in set(setting("takeover", TAKEOVER)):
        ours = None
        state.pop("anchor", None)

        # the host is the answer and parsing finds it exactly, so no model is
        # asked. It would otherwise reach for the user, which is the same on
        # every machine and identifies none of them.
        direct = slug(ssh_label(" ".join(sys.argv[1:])))
        if direct:
            record({"tab": tab, "kind": "ssh", "input": text[:MAX_INPUT], "was": state.get("name"),
                    "name": direct, "changed": True, "model": "", "ms": 0,
                    "tokens_in": 0, "tokens_out": 0})
            state.update(anchor=text, asked_at=time.time(), seen=0, kept=0, name=direct)
            state.pop("fresh", None)
            subprocess.run(["herdr", "tab", "rename", tab, direct], capture_output=True, timeout=5)
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(path, "w") as handle:
                json.dump(state, handle)
            return
    elif ours and len(sys.argv) > 1:
        return

    # a name that keeps surviving is unlikely to need changing, so each
    # unchanged answer doubles the number of inputs skipped before the next
    # check. Counted in inputs rather than seconds: an hour away from the
    # keyboard changes nothing about what the tab is for.
    kept = state.get("kept", 0)
    seen = state.get("seen", 0) + 1
    if ours and seen < min(int(setting("pace", 1)) * (2 ** kept), int(setting("pace_max", 32))):
        state["seen"] = seen
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(path, "w") as handle:
            json.dump(state, handle)
        return

    anchor = state.get("anchor") or text[:MAX_INPUT]
    text = text[:MAX_INPUT]
    started = time.time()
    answer, usage = ask_model(f"{PROMPT}\n\nANCHOR: {anchor}\nNAME: {ours or '(none)'}\nLATEST: {text}\n")
    name = slug(answer)
    record({
        "tab": tab, "kind": "prompt" if len(sys.argv) == 1 else "command",
        "input": text, "was": ours, "name": name, "changed": bool(name) and name != ours,
        "model": setting("model", ""), "ms": int((time.time() - started) * 1000),
        "tokens_in": usage.get("prompt_tokens"), "tokens_out": usage.get("completion_tokens"),
    })
    if not name:
        return

    state.update(anchor=anchor, asked_at=time.time(), seen=0, kept=kept + 1 if name == ours else 0)
    state.pop("fresh", None)
    if name != ours:
        subprocess.run(["herdr", "tab", "rename", tab, name], capture_output=True, timeout=5)
        state["name"] = name

    os.makedirs(STATE_DIR, exist_ok=True)
    with open(path, "w") as handle:
        json.dump(state, handle)


main()
